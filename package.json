{
  "name": "fingerprint",
  "version": "0.1.0-alpha.0",
  "description": "Add Fingerprint device intelligence to your app in one command",
  "keywords": [
    "fingerprint",
    "cli",
    "device intelligence",
    "device fingerprint",
    "identification",
    "fraud",
    "fraud detection",
    "fraud prevention",
    "bot detection"
  ],
  "license": "MIT",
  "type": "module",
  "author": "FingerprintJS, Inc (https://fingerprint.com)",
  "homepage": "https://github.com/fingerprintjs/fingerprint-cli#readme",
  "bugs": {
    "url": "https://github.com/fingerprintjs/fingerprint-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fingerprintjs/fingerprint-cli.git"
  },
  "bin": {
    "fingerprint": "./dist/index.js"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "files": [
    "dist",
    "README.md",
    "NOTICES.txt"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "postbuild": "chmod +x dist/index.js",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "test": "npm run build && node --test",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "packageManager": "pnpm@11.1.3",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.162",
    "@inquirer/prompts": "^8.0.1",
    "commander": "^14.0.1",
    "open": "^10.2.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@fingerprintjs/changesets-changelog-format": "^0.2.0",
    "@types/node": "^24.9.1",
    "typescript": "^5.9.3"
  }
}
